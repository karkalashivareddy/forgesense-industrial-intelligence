# ForgeSense control room — local development overrides.
# Copy to `.env.local` and edit. `.env.local` is gitignored. Never put secrets here.
#
# Public runtime configuration only. This bundle is served to the browser, so
# nothing in this file may be a credential.

# Spring Boot API origin (no trailing slash).
VITE_API_BASE_URL=http://localhost:8080

# Realtime STOMP endpoint. Defaults to the API origin with http->ws when unset.
# VITE_WS_URL=ws://localhost:8080/ws

# Set to `false` to hide the global "synthetic data" advisory banner.
# The advisory is on by default and should stay on: ForgeSense renders
# synthetic simulator telemetry, never real industrial measurements.
VITE_SHOW_SYNTHETIC_ADVISORY=true
