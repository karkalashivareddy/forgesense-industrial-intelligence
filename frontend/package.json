{
  "name": "forgesense-frontend",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "ForgeSense Industrial Operations Center — React + TypeScript + Vite control room",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc -b --pretty",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "visual-qa": "playwright test e2e/visual.spec.ts --project=visual",
    "lint:artifacts": "node scripts/check-artifacts.mjs",
    "check:docs": "node scripts/check-docs.mjs",
    "verify": "npm run check:docs && npm run lint:artifacts && npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@tanstack/react-query": "5.62.7",
    "echarts": "5.5.1",
    "lucide-react": "0.469.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.28.0",
    "three": "0.169.0",
    "zustand": "5.0.2"
  },
  "devDependencies": {
    "@playwright/test": "1.49.1",
    "@types/node": "^22.10.5",
    "@types/react": "18.3.17",
    "@types/react-dom": "18.3.5",
    "@types/three": "0.169.0",
    "@vitejs/plugin-react": "4.3.4",
    "jsdom": "25.0.1",
    "typescript": "5.7.2",
    "vite": "6.0.5",
    "vitest": "2.1.8"
  }
}
