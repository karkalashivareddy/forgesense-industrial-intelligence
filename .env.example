# ============================================================
# ForgeSense environment configuration (example)
# Copy to .env and adjust. NEVER commit the real .env file.
# ============================================================

# --- Profiles ---
# dev   = H2 (PostgreSQL mode) + in-memory cache + in-process event bus
# docker= PostgreSQL + Redis + Kafka (see docker-compose.yml)
SPRING_PROFILES_ACTIVE=dev
FORGESENSE_DEMO_MODE=true

# --- PostgreSQL (used with the docker profile) ---
POSTGRES_DB=forgesense
POSTGRES_USER=forgesense
POSTGRES_PASSWORD=your_postgres_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Redis (used with the docker profile) ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# --- Kafka (used with the docker profile) ---
KAFKA_BOOTSTRAP_SERVERS=localhost:29092
FORGESENSE_STREAMING_KAFKA_ENABLED=false

# --- ML service ---
FORGESENSE_ML_URL=http://localhost:8001

# --- Backend / API ---
BACKEND_PORT=8080
FRONTEND_PORT=5173
ML_PORT=8001
SIMULATOR_PORT=8002

# --- Security (JWT / OAuth) ---
# ForgeSense can run with a default dev credential set (operator/engineer/admin)
# through Spring Security form authentication. Never use production passwords here.
FORGESENSE_SECURITY_ENABLED=true
FORGESENSE_JWT_SECRET=your_jwt_secret_at_least_32_characters_long
FORGESENSE_DEV_PASSWORD=your_local_dev_password
FORGESENSE_JWT_EXPIRATION=3600

# --- Observability ---
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_PASSWORD=your_grafana_admin_password
