# ============================================================
# ForgeSense environment configuration (example)
# Copy to .env and adjust. NEVER commit the real .env file.
# ============================================================

# --- Profiles ---
# dev   = H2 (PostgreSQL mode) + in-memory cache + in-process event bus
# docker= PostgreSQL + Redis + Kafka (see docker-compose.yml)
SPRING_PROFILES_ACTIVE=dev
FORGESENSE_DEMO_MODE=true

# --- PostgreSQL (used with the docker profile) ---
POSTGRES_DB=forgesense
POSTGRES_USER=forgesense
POSTGRES_PASSWORD=forgesense_dev_pw
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Redis (used with the docker profile) ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# --- Kafka (used with the docker profile) ---
KAFKA_BOOTSTRAP_SERVERS=localhost:29092
FORGESENSE_STREAMING_KAFKA_ENABLED=false

# --- ML service ---
FORGESENSE_ML_URL=http://localhost:8001

# --- Shared machine profile catalog ---
# Leave unset to use the built-in default resolution (repo config/ dir).
# Set it when running from an unusual working directory or container mount.
# FORGESENSE_PROFILES_FILE=config/machine_profiles.json

# --- Backend / API ---
BACKEND_PORT=8080
FRONTEND_PORT=5173
ML_PORT=8001
SIMULATOR_PORT=8002

# --- CORS ---
# Comma-separated list of origins allowed to call the backend API and the
# WebSocket endpoints (the browser frontend).
FORGESENSE_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Security (JWT / OAuth) ---
# ForgeSense can run with a default dev credential set (operator/engineer/admin)
# through Spring Security form authentication. Never use production passwords here.
# Property layout: forgesense.security.jwt-secret / forgesense.security.jwt-expiration-seconds
FORGESENSE_SECURITY_ENABLED=true
FORGESENSE_SECURITY_JWT_SECRET=change-me-in-production-48-bytes-minimum-change-me
FORGESENSE_SECURITY_JWT_EXPIRATION_SECONDS=86400
# Default dev password shown in the frontend demo; override per environment.
# The docker-compose backend service REQUIRES this variable to be set.
FORGESENSE_DEV_PASSWORD=forgesense-dev

# --- Observability ---
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000